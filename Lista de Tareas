import java.util.ArrayList;
import java.util.Collections;
import java.util.Scanner;

class Tareas {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        ArrayList<String> tareas = new ArrayList<>();

        System.out.print("Cuantas tareas desea ingresar? ");
        int cantidad = scanner.nextInt();
        scanner.nextLine();

        for (int i = 0; i < cantidad; i++) {
            System.out.print("Ingrese una tarea: ");
            String tarea = scanner.nextLine();
            tareas.add(tarea);
        }

        System.out.print("Ingrese una nueva tarea: ");
        String nuevaTarea = scanner.nextLine();

        System.out.print("Ingrese la posicion donde desea insertarla: ");
        int posicion = scanner.nextInt();
        scanner.nextLine();

        if (posicion >= 0 && posicion <= tareas.size()) {
            tareas.add(posicion, nuevaTarea);
        } else {
            System.out.println("Posicion incorrecta.");
        }

        System.out.print("Ingrese el nombre de la tarea que desea eliminar: ");
        String eliminar = scanner.nextLine();

        tareas.remove(eliminar);

        Collections.sort(tareas);

        System.out.println("Lista de tareas pendientes:");

        for (String tarea : tareas) {
            System.out.println(tarea);
        }

        scanner.close();
    }
}
